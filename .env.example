# Copy to .env and fill in. Never commit .env.

# Tailscale auth key (admin console -> Settings -> Keys). Needed only for first start;
# remove it from .env afterwards.
TS_AUTHKEY=tskey-auth-REDACTED

# Full tailnet name of the sidecar (check the exact name in the Tailscale admin console)
VAULT_DOMAIN=vault.<your-tailnet>.ts.net

# Set to true ONLY while creating your first account, then back to false
SIGNUPS_ALLOWED=false

# Password that encrypts the backup archives. Store a copy OUTSIDE Vaultwarden.
ZIP_PASSWORD=REDACTED-use-a-long-random-string
